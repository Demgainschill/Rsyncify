<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f4f1ea;" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox style="-fx-padding: 22 32 8 32;">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Transfer in Progress" />
            <Label fx:id="statusLabel" style="-fx-text-fill: #555; -fx-padding: 6 0 0 0;" text="Preparing transfer..." />
        </VBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding: 10 32 20 32;">
            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Activity Log" />
            <TextArea fx:id="logArea" editable="false" prefHeight="280" style="-fx-font-family: 'JetBrains Mono', monospace; -fx-font-size: 12px; -fx-background-color: #faf8f5;" wrapText="true" />
            
            <Separator />
            
            <VBox alignment="CENTER" spacing="8">
                <ProgressBar fx:id="progressBar" prefHeight="18" prefWidth="628.0" progress="0" />
                <Label fx:id="percentLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0%" />
              <HBox alignment="CENTER" prefHeight="0.0" prefWidth="624.0" spacing="14" style="-fx-padding: 16;">
                  <Button fx:id="pauseBtn" onAction="#pauseTransfer" style="-fx-background-color: #e8e0d0; -fx-text-fill: #2c2825; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 6; -fx-border-color: #c9c0b0; -fx-border-radius: 6;" text="Pause" />
                  <Button fx:id="resumeBtn" disable="true" onAction="#resumeTransfer" style="-fx-background-color: #e8e0d0; -fx-text-fill: #2c2825; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 6; -fx-border-color: #c9c0b0; -fx-border-radius: 6;" text="Resume" />
                  <Button fx:id="stopBtn" onAction="#stopTransfer" style="-fx-background-color: #c45c4a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 6;" text="Stop" />
                  <Button onAction="#backToMain" style="-fx-background-color: #e8e0d0; -fx-text-fill: #2c2825; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 6; -fx-border-color: #c9c0b0; -fx-border-radius: 6;" text="Return to Setup" />
              </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
